# Copy to backend/.env and paste a key from https://console.x.ai
# Grades, reef health, and the whole booth still run with this left blank.
# Blank means Grok answers are simulated and reward art stays as SVG.
XAI_API_KEY=

# Text model that answers the squad's prompt.
GROK_MODEL=grok-4.6

# Grok Imagine model. Used only after an A or A+ prompt, so the booth does not
# spend an image on every sludge barrel.
GROK_IMAGE_MODEL=grok-imagine-image-2.0
GROK_IMAGES=true

# Where live games are saved so a backend reload does not wipe the lobby.
DATA_PATH=data/sessions.json

# Prompt judge (docs/PROMPT-JUDGE.md). The Grok reviewer's model. A fast,
# non-reasoning model is best. Blank means the same model as GROK_MODEL.
GROK_JUDGE_MODEL=

# Shared secret for full-mode calls to POST /api/judge. The plugin sends it in
# the X-Judge-Key header. Blank keeps full mode off for outside callers, so
# nobody on the internet can spend your Grok key. Fast mode is always open.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
JUDGE_API_KEY=

# Most full-mode judgments (reviewer + real Grok runs) per minute, across all callers.
JUDGE_FULL_PER_MINUTE=20

# Write every judged prompt (credentials redacted) to data/judge-log.jsonl so you
# can label real prompts and add them to the tests. Off by default.
JUDGE_LOG=false
