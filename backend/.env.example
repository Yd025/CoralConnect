# Copy to backend/.env and paste a key from https://console.x.ai
# Grades, reef health, and the whole booth still run with this left blank.
# Blank means Grok answers are simulated and reward art stays as SVG.
XAI_API_KEY=

# Text model that answers the squad's prompt.
GROK_MODEL=grok-4.6

# Grok Imagine model. Used only after an A or A+ prompt, so the booth does not
# spend an image on every sludge barrel.
GROK_IMAGE_MODEL=grok-imagine-image-2.0
GROK_IMAGES=true

# Where live games are saved so a backend reload does not wipe the lobby.
DATA_PATH=data/sessions.json
